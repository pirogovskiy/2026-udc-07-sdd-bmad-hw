+// Discount engine: loyalty tiers + coupon codes.
+//
+// The feature request (materials/feature-request.md) is deliberately
+// ambiguous. Below are the decisions this implementation makes to turn it
+// into something testable. None of these is "the" right answer — they are
+// the ones this codebase commits to.
+//
+// 1. Discount BASE is the item subtotal only (subtotalKopecks). Shipping is
+//    added afterwards, undiscounted — discounts are about products, not
+//    delivery.
+//
+// 2. Stacking is SEQUENTIAL (compounding), not additive, and runs in this
+//    fixed order:
+//      a) category-scoped coupons, in the order the customer typed them —
+//         each computed off THAT CATEGORY's own remaining value;
+//      b) the loyalty-tier discount, off the order's remaining subtotal;
+//      c) non-category coupons, in the order the customer typed them, each
+//         off the order's remaining subtotal.
+//    Compounding (10% then 15% of what's left) rather than adding
+//    percentages (25% flat) is the choice made here: it can never push the
+//    combined rate over 100%, which an additive scheme can.
+//
+// 3. Multiple coupons: ALL valid coupons are applied (not "best only"), in
+//    entry order. A code repeated in `order.coupons` is applied once; the
+//    repeat is reported as rejected ("duplicate"). Unknown or expired codes
+//    are silently skipped rather than throwing — the ticket says expired
+//    codes "should not work", not "should error" — but every skip is
+//    reported in `rejectedCoupons` so a caller can still tell the customer
+//    why.
+//
+// 4. Rounding happens PER STEP, to the nearest kopeck, half rounds up. Each
+//    discount step produces a whole-kopeck amount before the next step reads
+//    the running total, so nothing fractional ever carries forward.
+//
+// 5. A category coupon's percentage is computed off that category's own
+//    subtotal, not the whole order's.
+//
+// 6. `minSubtotalKopecks` is checked once, against the order's ORIGINAL
+//    (pre-discount) item subtotal — an earlier discount can't retroactively
+//    disqualify a coupon that already cleared the bar.
+//
+// 7. The total can't go negative: every step's discount is capped to its own
+//    remaining base (a percentage of a non-negative base is non-negative and
+//    ≤ the base; a fixed amount is clamped with Math.min to the base), so
+//    the discounted subtotal can reach 0 but never cross below it.
+import type { Coupon, LineItem, Order } from "./types.js";
+import { lineTotalKopecks, shippingKopecks, subtotalKopecks, tierPercent } from "./pricing.js";
+
+export type CouponRejectionReason =
+  | "duplicate"
+  | "not_found"
+  | "expired"
+  | "min_subtotal_not_met"
+  | "empty_category";
+
+export interface RejectedCoupon {
+  code: string;
+  reason: CouponRejectionReason;
+}
+
+export interface DiscountStep {
+  source: "category_coupon" | "tier" | "coupon";
+  code?: string;
+  category?: LineItem["category"];
+  amountKopecks: number;
+}
+
+export interface DiscountBreakdown {
+  subtotalKopecks: number;
+  discountKopecks: number;
+  discountedSubtotalKopecks: number;
+  shippingKopecks: number;
+  totalKopecks: number;
+  steps: DiscountStep[];
+  appliedCoupons: string[];
+  rejectedCoupons: RejectedCoupon[];
+}
+
+function roundKopecks(amount: number): number {
+  return Math.round(amount);
+}
+
+function percentOf(baseKopecks: number, percent: number): number {
+  return roundKopecks((baseKopecks * percent) / 100);
+}
+
+function isExpired(coupon: Coupon, now: Date): boolean {
+  return now.getTime() >= new Date(coupon.expiresAt).getTime();
+}
+
+/** Splits the item subtotal by category, in whole kopecks. */
+function subtotalByCategory(order: Order): Map<LineItem["category"], number> {
+  const byCategory = new Map<LineItem["category"], number>();
+  for (const item of order.items) {
+    byCategory.set(item.category, (byCategory.get(item.category) ?? 0) + lineTotalKopecks(item));
+  }
+  return byCategory;
+}
+
+/** Resolves each entered code against the catalog, dropping duplicates, unknown, expired and disqualified ones. */
+function resolveCoupons(order: Order, catalog: Coupon[], subtotal: number, now: Date, rejected: RejectedCoupon[]): Coupon[] {
+  const seen = new Set<string>();
+  const valid: Coupon[] = [];
+
+  for (const code of order.coupons) {
+    if (seen.has(code)) {
+      rejected.push({ code, reason: "duplicate" });
+      continue;
+    }
+    seen.add(code);
+
+    const coupon = catalog.find((c) => c.code === code);
+    if (!coupon) {
+      rejected.push({ code, reason: "not_found" });
+      continue;
+    }
+    if (isExpired(coupon, now)) {
+      rejected.push({ code, reason: "expired" });
+      continue;
+    }
+    if (coupon.minSubtotalKopecks !== undefined && subtotal < coupon.minSubtotalKopecks) {
+      rejected.push({ code, reason: "min_subtotal_not_met" });
+      continue;
+    }
+    valid.push(coupon);
+  }
+
+  return valid;
+}
+
+export function calculateOrderTotal(order: Order, catalog: Coupon[], now: Date = new Date()): DiscountBreakdown {
+  const subtotal = subtotalKopecks(order);
+  const shipping = shippingKopecks(order);
+
+  const rejectedCoupons: RejectedCoupon[] = [];
+  const validCoupons = resolveCoupons(order, catalog, subtotal, now, rejectedCoupons);
+
+  const steps: DiscountStep[] = [];
+  const appliedCoupons: string[] = [];
+  const byCategory = subtotalByCategory(order);
+
+  for (const coupon of validCoupons) {
+    if (!coupon.category) continue;
+    if (!byCategory.has(coupon.category)) {
+      rejectedCoupons.push({ code: coupon.code, reason: "empty_category" });
+      continue;
+    }
+    const remaining = byCategory.get(coupon.category) ?? 0;
+    const amount = coupon.kind === "percent" ? percentOf(remaining, coupon.value) : Math.min(coupon.value, remaining);
+    byCategory.set(coupon.category, remaining - amount);
+    steps.push({ source: "category_coupon", code: coupon.code, category: coupon.category, amountKopecks: amount });
+    appliedCoupons.push(coupon.code);
+  }
+
+  let remainingSubtotal = 0;
+  for (const value of byCategory.values()) remainingSubtotal += value;
+
+  const tierPct = tierPercent(order);
+  if (tierPct > 0) {
+    const amount = percentOf(remainingSubtotal, tierPct);
+    remainingSubtotal -= amount;
+    steps.push({ source: "tier", amountKopecks: amount });
+  }
+
+  for (const coupon of validCoupons) {
+    if (coupon.category) continue;
+    const amount =
+      coupon.kind === "percent" ? percentOf(remainingSubtotal, coupon.value) : Math.min(coupon.value, remainingSubtotal);
+    remainingSubtotal -= amount;
+    steps.push({ source: "coupon", code: coupon.code, amountKopecks: amount });
+    appliedCoupons.push(coupon.code);
+  }
+
+  return {
+    subtotalKopecks: subtotal,
+    discountKopecks: subtotal - remainingSubtotal,
+    discountedSubtotalKopecks: remainingSubtotal,
+    shippingKopecks: shipping,
+    totalKopecks: remainingSubtotal + shipping,
+    steps,
+    appliedCoupons,
+    rejectedCoupons,
+  };
+}
