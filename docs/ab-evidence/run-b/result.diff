+import { describe, it, expect } from "vitest";
+import { calculateOrderTotal } from "./discounts.js";
+import type { Coupon, LineItem, Order } from "./types.js";
+
+// Amounts are whole kopecks. 25_000 = 250 грн.
+const item = (over: Partial<LineItem> = {}): LineItem => ({
+  sku: "AA-1",
+  name: "Thing",
+  unitPriceKopecks: 25_000,
+  quantity: 1,
+  category: "standard",
+  ...over,
+});
+
+const order = (over: Partial<Order> = {}): Order => ({
+  id: "o1",
+  items: [item()],
+  country: "UA",
+  customerTier: "none",
+  coupons: [],
+  ...over,
+});
+
+const coupon = (over: Partial<Coupon> = {}): Coupon => ({
+  code: "CODE",
+  kind: "percent",
+  value: 10,
+  expiresAt: "2999-01-01T00:00:00Z",
+  ...over,
+});
+
+const NOW = new Date("2026-01-01T00:00:00Z");
+
+describe("calculateOrderTotal — loyalty tier only", () => {
+  it("applies no discount for tier none", () => {
+    const o = order({ items: [item({ unitPriceKopecks: 100_000 })], customerTier: "none" });
+    const r = calculateOrderTotal(o, [], NOW);
+    expect(r.discountKopecks).toBe(0);
+    expect(r.discountedSubtotalKopecks).toBe(100_000);
+  });
+
+  it("applies silver's 5% off the item subtotal", () => {
+    const o = order({ items: [item({ unitPriceKopecks: 100_000 })], customerTier: "silver" });
+    const r = calculateOrderTotal(o, [], NOW);
+    expect(r.discountKopecks).toBe(5_000);
+    expect(r.discountedSubtotalKopecks).toBe(95_000);
+  });
+
+  it("applies gold's 10% off the item subtotal, not off shipping", () => {
+    const o = order({ items: [item({ unitPriceKopecks: 100_000 })], customerTier: "gold", country: "PL" });
+    const r = calculateOrderTotal(o, [], NOW);
+    // shipping (199 грн, international) must stay undiscounted
+    expect(r.shippingKopecks).toBe(19_900);
+    expect(r.discountKopecks).toBe(10_000);
+    expect(r.totalKopecks).toBe(90_000 + 19_900);
+  });
+});
+
+describe("calculateOrderTotal — coupons", () => {
+  it("rejects an unknown code without throwing", () => {
+    const o = order({ coupons: ["GHOST"] });
+    const r = calculateOrderTotal(o, [], NOW);
+    expect(r.appliedCoupons).toEqual([]);
+    expect(r.rejectedCoupons).toEqual([{ code: "GHOST", reason: "not_found" }]);
+  });
+
+  it("rejects an expired coupon silently and reports why", () => {
+    const c = coupon({ code: "OLD10", expiresAt: "2020-01-01T00:00:00Z" });
+    const o = order({ items: [item({ unitPriceKopecks: 100_000 })], coupons: ["OLD10"] });
+    const r = calculateOrderTotal(o, [c], NOW);
+    expect(r.discountKopecks).toBe(0);
+    expect(r.rejectedCoupons).toEqual([{ code: "OLD10", reason: "expired" }]);
+  });
+
+  it("treats expiresAt as exclusive: not valid AT the expiry instant", () => {
+    const c = coupon({ code: "EDGE", expiresAt: NOW.toISOString() });
+    const o = order({ coupons: ["EDGE"] });
+    const r = calculateOrderTotal(o, [c], NOW);
+    expect(r.rejectedCoupons).toEqual([{ code: "EDGE", reason: "expired" }]);
+  });
+
+  it("applies a fixed-amount coupon, capped so it can't push the subtotal below zero", () => {
+    const c = coupon({ code: "FIXED", kind: "fixed", value: 999_000 });
+    const o = order({ items: [item({ unitPriceKopecks: 10_000 })], coupons: ["FIXED"] });
+    const r = calculateOrderTotal(o, [c], NOW);
+    expect(r.discountedSubtotalKopecks).toBe(0);
+    expect(r.discountKopecks).toBe(10_000);
+  });
+
+  it("rejects a coupon below its minimum subtotal", () => {
+    const c = coupon({ code: "BIG50", kind: "percent", value: 50, minSubtotalKopecks: 200_000 });
+    const o = order({ items: [item({ unitPriceKopecks: 100_000 })], coupons: ["BIG50"] });
+    const r = calculateOrderTotal(o, [c], NOW);
+    expect(r.rejectedCoupons).toEqual([{ code: "BIG50", reason: "min_subtotal_not_met" }]);
+    expect(r.discountKopecks).toBe(0);
+  });
+
+  it("checks minSubtotal against the ORIGINAL subtotal, not a post-discount one", () => {
+    // Order subtotal is 100 000; a prior discount would drop it under the
+    // 80 000 bar, but the coupon must still qualify because it's checked
+    // against the pre-discount amount.
+    const c = coupon({ code: "QUALIFIES", kind: "percent", value: 10, minSubtotalKopecks: 80_000 });
+    const o = order({
+      items: [item({ unitPriceKopecks: 100_000 })],
+      customerTier: "gold", // -10% first
+      coupons: ["QUALIFIES"],
+    });
+    const r = calculateOrderTotal(o, [c], NOW);
+    expect(r.appliedCoupons).toEqual(["QUALIFIES"]);
+    expect(r.rejectedCoupons).toEqual([]);
+  });
+
+  it("collapses a repeated code into a single application and reports the repeat", () => {
+    const c = coupon({ code: "ONCE", kind: "percent", value: 10 });
+    const o = order({ items: [item({ unitPriceKopecks: 100_000 })], coupons: ["ONCE", "ONCE"] });
+    const r = calculateOrderTotal(o, [c], NOW);
+    expect(r.appliedCoupons).toEqual(["ONCE"]);
+    expect(r.rejectedCoupons).toEqual([{ code: "ONCE", reason: "duplicate" }]);
+    expect(r.discountKopecks).toBe(10_000);
+  });
+
+  it("applies several distinct coupons in the order the customer typed them", () => {
+    const a = coupon({ code: "A", kind: "percent", value: 10 });
+    const b = coupon({ code: "B", kind: "percent", value: 20 });
+    const o = order({ items: [item({ unitPriceKopecks: 100_000 })], coupons: ["A", "B"] });
+    const r = calculateOrderTotal(o, [a, b], NOW);
+    // sequential/compounding, not additive: 100_000 -> -10% -> 90_000 -> -20% -> 72_000
+    expect(r.discountedSubtotalKopecks).toBe(72_000);
+    expect(r.appliedCoupons).toEqual(["A", "B"]);
+  });
+});
+
+describe("calculateOrderTotal — category-scoped coupons", () => {
+  it("computes a category coupon's percentage off that category's own subtotal", () => {
+    const c = coupon({ code: "FRESH20", kind: "percent", value: 20, category: "fresh" });
+    const o = order({
+      items: [
+        item({ sku: "F1", unitPriceKopecks: 40_000, category: "fresh" }),
+        item({ sku: "S1", unitPriceKopecks: 60_000, category: "standard" }),
+      ],
+      coupons: ["FRESH20"],
+    });
+    const r = calculateOrderTotal(o, [c], NOW);
+    // 20% of the 40_000 fresh line only, not of the 100_000 order subtotal
+    expect(r.discountKopecks).toBe(8_000);
+    expect(r.discountedSubtotalKopecks).toBe(92_000);
+  });
+
+  it("rejects a category coupon when the order has no items in that category", () => {
+    const c = coupon({ code: "DIGI10", kind: "percent", value: 10, category: "digital" });
+    const o = order({ items: [item({ category: "standard" })], coupons: ["DIGI10"] });
+    const r = calculateOrderTotal(o, [c], NOW);
+    expect(r.rejectedCoupons).toEqual([{ code: "DIGI10", reason: "empty_category" }]);
+    expect(r.discountKopecks).toBe(0);
+  });
+
+  it("combines a category coupon with the loyalty tier and a store-wide coupon", () => {
+    const catCoupon = coupon({ code: "FRESH10", kind: "percent", value: 10, category: "fresh" });
+    const wide = coupon({ code: "WIDE5", kind: "percent", value: 5 });
+    const o = order({
+      items: [
+        item({ sku: "F1", unitPriceKopecks: 50_000, category: "fresh" }),
+        item({ sku: "S1", unitPriceKopecks: 50_000, category: "standard" }),
+      ],
+      customerTier: "gold", // 10%
+      coupons: ["FRESH10", "WIDE5"],
+    });
+    const r = calculateOrderTotal(o, [catCoupon, wide], NOW);
+    // 1) FRESH10 on the fresh line: 50_000 -> -10% -> 45_000 (fresh line loses 5_000)
+    // remaining subtotal now 95_000
+    // 2) gold tier 10% off 95_000 -> 9_500 -> remaining 85_500
+    // 3) WIDE5 5% off 85_500 -> round(4_275) -> remaining 81_225
+    expect(r.discountedSubtotalKopecks).toBe(81_225);
+    expect(r.appliedCoupons).toEqual(["FRESH10", "WIDE5"]);
+  });
+});
+
+describe("calculateOrderTotal — rounding and money conservation", () => {
+  it("rounds each step to the nearest whole kopeck, half rounding up", () => {
+    // 33% of 1 kopeck's worth of odd subtotal to force a .5 boundary:
+    // 1 грн (100 kopecks) at 33% is 33 kopecks exactly; use 15% of 250 to get a half.
+    const c = coupon({ code: "HALF", kind: "percent", value: 15 });
+    const o = order({ items: [item({ unitPriceKopecks: 250 })], coupons: ["HALF"] });
+    const r = calculateOrderTotal(o, [c], NOW);
+    // 250 * 15 / 100 = 37.5 -> rounds up to 38
+    expect(r.discountKopecks).toBe(38);
+    expect(r.discountedSubtotalKopecks).toBe(212);
+  });
+
+  it("never produces a negative discounted subtotal, even with an oversized fixed coupon and a tier stacked on top", () => {
+    const c = coupon({ code: "HUGE", kind: "fixed", value: 1_000_000 });
+    const o = order({ items: [item({ unitPriceKopecks: 10_000 })], customerTier: "gold", coupons: ["HUGE"] });
+    const r = calculateOrderTotal(o, [c], NOW);
+    expect(r.discountedSubtotalKopecks).toBe(0);
+    expect(r.totalKopecks).toBeGreaterThanOrEqual(r.shippingKopecks);
+  });
+
+  it("keeps discount steps summing exactly to the total discount (no drift)", () => {
+    const a = coupon({ code: "A", kind: "percent", value: 13, category: "fresh" });
+    const b = coupon({ code: "B", kind: "percent", value: 7 });
+    const o = order({
+      items: [
+        item({ sku: "F1", unitPriceKopecks: 33_333, category: "fresh" }),
+        item({ sku: "S1", unitPriceKopecks: 66_667, category: "standard" }),
+      ],
+      customerTier: "silver",
+      coupons: ["A", "B"],
+    });
+    const r = calculateOrderTotal(o, [a, b], NOW);
+    const stepsSum = r.steps.reduce((sum, s) => sum + s.amountKopecks, 0);
+    expect(stepsSum).toBe(r.discountKopecks);
+    expect(r.discountedSubtotalKopecks + r.discountKopecks).toBe(r.subtotalKopecks);
+  });
+});
